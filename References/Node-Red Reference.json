[
    {
        "id": "inject1",
        "type": "inject",
        "z": "flow1",
        "name": "Trigger Stock Fetch",
        "props": [{"p": "payload"}],
        "repeat": "30",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 100,
        "wires": [["http1"]]
    },
    {
        "id": "http1",
        "type": "http request",
        "z": "flow1",
        "name": "Get AAPL Price",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://finnhub.io/api/v1/quote?symbol=AAPL&token=YOUR_API_KEY_HERE",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 370,
        "y": 100,
        "wires": [["function1"]]
    },
    {
        "id": "function1",
        "type": "function",
        "z": "flow1",
        "name": "Stock to Haptic",
        "func": "// Get stock data from Finnhub\nconst stock = msg.payload;\n\n// Extract values\nconst currentPrice = stock.c;      // current price\nconst change = stock.d;            // dollar change\nconst percentChange = stock.dp;    // percent change\nconst dayHigh = stock.h;\nconst dayLow = stock.l;\n\n// Calculate volatility\nconst dayRange = dayHigh - dayLow;\nconst volatility = (dayRange / currentPrice) * 100;\n\n// Map to haptic parameters\nconst intensity = Math.min(100, Math.max(10, Math.abs(percentChange) * 30));\nconst direction = percentChange >= 0 ? 'up' : 'down';\n\n// Create MQTT payload\nmsg.payload = {\n    intensity: Math.round(intensity),\n    direction: direction,\n    price: currentPrice,\n    change: percentChange,\n    volatility: Math.round(volatility * 10) / 10\n};\n\n// Log for debugging\nnode.warn(`💰 $${currentPrice} | ${percentChange >= 0 ? '📈' : '📉'} ${percentChange}% | ⚡ ${intensity}%`);\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 100,
        "wires": [["mqtt1", "debug1"]]
    },
    {
        "id": "mqtt1",
        "type": "mqtt out",
        "z": "flow1",
        "name": "Publish to Wearable",
        "topic": "multisense/stock/data",
        "qos": "0",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "broker1",
        "x": 830,
        "y": 100,
        "wires": []
    },
    {
        "id": "debug1",
        "type": "debug",
        "z": "flow1",
        "name": "View Haptic Data",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 830,
        "y": 160,
        "wires": []
    },
    {
        "id": "broker1",
        "type": "mqtt-broker",
        "name": "HiveMQ Public",
        "broker": "broker.hivemq.com",
        "port": "1883",
        "clientid": "",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
